{
  "name": "dsh-wb-sessions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Workbench session viewer: lists main-harness sessions, shows history, and forwards prompts through the bridge",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
